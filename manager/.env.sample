# Manager environment. Copy to manager/.env and edit.
# Loaded by docker compose for ${VAR} interpolation AND injected into the
# postgres + api containers via `env_file:` in docker-compose.yml.
#
# Two run modes:
#   * `pnpm dev` (host) — needs DATABASE_URL + MANAGER_PORT (+ LOG_LEVEL)
#   * `docker compose --profile full up` — additionally uses POSTGRES_PASSWORD.

# --- Postgres ---------------------------------------------------------------
# Used by the postgres container (POSTGRES_PASSWORD) and embedded into
# DATABASE_URL below. Any string; lives only inside this compose project.
POSTGRES_PASSWORD=pwd

# --- Manager API ------------------------------------------------------------
# Required. Connection string the running app uses to reach Postgres.
#   - Host mode (`pnpm dev` against the dockerized postgres on localhost:5432):
#       postgres://manager:<password>@localhost:5432/manager
#   - Docker mode (the `api` service): the compose file overrides this to
#       postgres://manager:${POSTGRES_PASSWORD}@postgres:5432/manager
#     so the value below is only used in host mode. Keep them in sync.
DATABASE_URL=postgres://manager:pwd@localhost:5432/manager

# Optional. Host port the manager API listens on. Default: 9876.
MANAGER_PORT=9876

# Optional. Public address (IP or DNS name) clients use to reach deployed
# components. deploy.sh sets this automatically from the server's host IP.
# If unset, the manager best-effort detects a non-internal IPv4 (note: inside
# Docker this only sees the bridge address), else falls back to localhost.
PUBLIC_HOST=

# Optional. Log level: trace | debug | info | warn | error. Default: info.
LOG_LEVEL=info

# --- Public HTTPS edge ------------------------------------------------------
# Optional. The DNS name the manager is reached at over HTTPS. Set it and
# deploy.sh starts the `public` compose profile, whose Caddy edge gets a
# certificate for exactly this name. Empty means no public edge, and the
# manager is reachable through the SSH tunnel only.
# The name needs an A record pointing at this host before the first deploy
# with it set. See "Opening the manager to the internet" in deploy/README.md.
MANAGER_DOMAIN=

# Optional. How little BZZ a deployment's own bee node may have available in its
# chequebook before the manager refuses to start its uploader. Default: 0.5.
# The chequebook pays the peers that forward this node's uploads, and below this
# the uploader would take segments and land none of them. A decimal amount above
# zero with at most 16 decimal places. A malformed value stops the manager at
# startup rather than reverting to the default, because this one number both
# gates deploys and is what the UI shows.
CHEQUEBOOK_FLOOR_BZZ=0.5

# Optional. Where added stack versions are checked out and built, one directory
# per version and about a gigabyte each. A sibling of the data root, outside the
# tree deploy/deploy.sh rsyncs with --delete, and bind-mounted into the api
# container at this same absolute path.
# Default: /home/solarpunk/streaming-infra-manager-versions
STACK_VERSIONS_ROOT=
