# Cut from .env.sample on main-v2 at ee99c36. What matters to the contract
# reader is what is NOT here: no API_AUTH_TOKEN and no CHEQUEBOOK_MIN_BZZ, so
# this version needs no generated secrets and has no chequebook gate.

STAMP=
STAMP_AMOUNT=10000000000
STAMP_DEPTH=20
STREAM_KEY=
STREAM_LIST_TOPIC=swarm-stream

BEE_URL=http://localhost:1633
API_PORT=3000
ENGINE=srs

BEE_UPLOADER_API_PORT=1633
BEE_GATEWAY_API_PORT=1733
