# Cut from .env.sample on main-v3 at be440d6: the keys the contract reader looks
# for, with the comment shapes it has to see past.

STAMP=
STREAM_KEY=
STREAM_LIST_TOPIC=swarm-stream

# Bearer token for every gated route. Required, with no unauthenticated mode,
# because every accepted segment spends postage stamp money. Minimum 32
# characters. Generate one with:  openssl rand -hex 32
API_AUTH_TOKEN=

# Publisher authentication, off when empty, so it is optional rather than
# required. The reader must not count it as a generated secret.
PUBLISH_KEY_SECRET=

# The chequebook floor, in BZZ, that every Bee node must hold AVAILABLE before
# the uploader will start. A dry chequebook is silent: the node answers /health
# while every paid push stalls.
CHEQUEBOOK_MIN_BZZ=0.5

STAMP_MIN_TTL_HOURS=24
STAMP_MAX_UTILIZATION=0.9

# Commented out on purpose upstream, so the entrypoint's own fallback decides
# it on both sides. The reader takes engine defaults from the entrypoints for
# exactly this reason.
# HLS_FRAGMENT=0.5
# How long a live stream may receive nothing before it is finalized as an orphan, for the case
# where an engine dies without sending on_unpublish. Deliberately the same 60s as
# RECOVERY_TIMEOUT rather than SEGMENT_STALL_MS.
ORPHAN_REAP_MS=60000

API_PORT=3000
ENGINE=srs

BEE_UPLOADER_API_PORT=1633
BEE_GATEWAY_API_PORT=1733

# One Bee node per ABR rung, so each rendition is published through a node of its own.
# Generate it rather than typing it: deploy/scripts/bee-publishers.sh asks each rung's node
# which batch it holds and with --write puts the line here.
# BEE_PUBLISHERS=360p@http://localhost:1633<batchid> 480p@http://localhost:1643<batchid>
BEE_PUBLISHERS=

# --- Logging --------------------------------------------------------------
# How much the stream-uploader prints, in rising order of quietness: debug, log, info, warn,
# error, silent. An unrecognized value is reported once and then ignored, so a typo here
# cannot stop the service from starting.
LOG_LEVEL=debug
