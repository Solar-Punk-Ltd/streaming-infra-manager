# Cut from engines/srs/.env.sample on main-v3 at be440d6. HLS_FRAGMENT and
# HLS_WINDOW moved out of here upstream, and SRS_WEBHOOK_TOKEN arrived, which is
# the second secret the manager has to generate per deployment.

ABR_ENABLED=false
ABR_LADDER=1080p:1920:1080:5000 720p:1280:720:2800 480p:854:480:1200 360p:640:360:700

ABR_VHOST=abr
# ABR_RTMP_PORT=

SRS_SRT_PORT=10080
SRT_PASSPHRASE=

# Shared secret SRS carries in its webhook URL. Required, with no unauthenticated mode: these
# webhooks reach the same stamp-spending path as the /stream routes, so an open one is a funds
# drain. Unreserved URL characters only, minimum 32.
SRS_WEBHOOK_TOKEN=

SRS_ADAPTER_HOST=localhost
SRS_ADAPTER_PORT=3000
