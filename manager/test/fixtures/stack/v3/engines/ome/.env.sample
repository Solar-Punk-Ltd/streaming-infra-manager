# Cut from engines/ome/.env.sample on main-v3 at be440d6: the second engine of the
# stack, so a version that ships two engine samples seeds and shows two engine
# sections rather than one.

# Segment length in seconds, and how many the playlist keeps.
HLS_SEGMENT_DURATION=2
HLS_SEGMENT_COUNT=5

OME_SRT_PORT=10081
OME_HLS_PORT=8081

# Shared secret for the admission webhook: OME signs its requests with it and the
# stream-uploader verifies the X-OME-Signature header. Required when ENGINE=ome,
# and left empty here on purpose.
OME_ADMISSION_SECRET=

# Allow connections when the admission handler errors, false rejects them.
OME_ADMISSION_FAIL_OPEN=false
