# The environment the integration suite reads. Copy this file to env.itest in
# this directory, which git ignores. The two credentials are empty on purpose:
# fill them with references that your secret tool resolves when it runs the
# suite, never with the values themselves. Never put a value in this file.
MANAGER_URL=http://localhost:9876
MANAGER_TEST_TARGET=http://localhost:9876
MANAGER_TEST_USERNAME=
MANAGER_TEST_PASSWORD=
# MANAGER_TEST_RUN=nightly1
