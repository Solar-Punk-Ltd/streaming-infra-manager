# The environment the integration suite reads. Copy this file to env.itest in
# this directory, which git ignores, fill in the vault references, and run
#   op run --env-file test/integration/env.itest -- pnpm test:integration
# from manager/. op run resolves the op:// references into the process and
# nowhere else. Never put a value in this file.
MANAGER_URL=http://localhost:9876
MANAGER_TEST_TARGET=http://localhost:9876
MANAGER_TEST_USERNAME=op://<vault>/<item>/username
MANAGER_TEST_PASSWORD=op://<vault>/<item>/password
# MANAGER_TEST_RUN=nightly1
