// `tsconfig.json` is the *build* config: rootDir is src, so it cannot include
// tests without breaking the emit. Tests were therefore never type-checked —
// `tsx --test` strips types without checking them, so a type error in a test
// file was invisible to `pnpm typecheck` and to CI.
//
// allowJs is on so a test can import the plain Node runner in
// test/database/run-all.mjs and get its inferred types. checkJs stays off, so
// the runner itself is read rather than checked.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "allowJs": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
