{
  "name": "@streaming-infra-manager/frontend-prototype",
  "private": true,
  "version": "0.0.0-prototype",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "pnpm --filter @streaming-infra-manager/common build && node --import tsx --conditions=development dev/mock-manager.mjs",
    "build": "pnpm --filter @streaming-infra-manager/common build && tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsx --conditions=development --test 'src/**/*.test.ts'",
    "test:browser": "node test/run-all.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@streaming-infra-manager/common": "workspace:*",
    "@emotion/react": "11.13.5",
    "@emotion/styled": "11.13.5",
    "@mui/icons-material": "6.1.10",
    "@mui/material": "6.1.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
