# ─────────────────────────────────────────────────────────────────────────────
# E2E target configuration. Copy this to `.env` and edit for YOUR deployment:
#     cp .env.example .env
# `.env` is git-ignored. Shell-exported vars override `.env`, e.g.
#     E2E_PROFILE=my-profile pnpm test:e2e
# ─────────────────────────────────────────────────────────────────────────────

# How the suite reaches the stack:
#   attach = point at an already-deployed profile over ssh (default; no deploy, no BZZ spend)
#   deploy = NOT IMPLEMENTED yet — setting this errors out (deploy the profile yourself instead)
E2E_MODE=attach

# ssh target for container control + curl. Must resolve non-interactively in ~/.ssh/config.
E2E_SSH_TARGET=manager-host

# Public host/IP where the SRT publisher and the viewer reach the deployment. REQUIRED for real runs.
E2E_PUBLIC_HOST=203.0.113.10

# docker-compose project = profile = container-name prefix (e.g. <profile>-stream-uploader-1).
E2E_PROFILE=srs-check-test1

# Port slot the profile was deployed on. Ports = base + slot*10 (mirrors the manager's layout).
E2E_PORT_SLOT=2

# HLS stream path used in the SRT streamid.
#   SRS: `live/<name>`   OME: `<app>/<name>` where app is `video` or `audio` (e.g. video/stream)
E2E_STREAM_PATH=live/stream

# Manager API base — deploy mode only, unused in attach.
E2E_MANAGER_API=http://localhost:8080
